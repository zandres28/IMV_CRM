otro\nFecha en formato YYYY-MM-DD. Monto como numero entero sin puntos (ej: 85000).\n\nSi NO es comprobante, responde SOLO: {\"es_comprobante\":false}\n\nContexto del mensaje: \"${messageContent}\"`;\n\nreturn [{\n  json: {\n    phone,\n    conversationId,\n    attachmentUrl,\n    senderName,\n    openaiPayload: {\n      model: 'gpt-4o-mini',\n      messages: [{\n        role: 'user',\n        content: [\n          { type: 'text', text: prompt },\n          { type: 'image_url', image_url: { url: attachmentUrl, detail: 'auto' } }\n        ]\n      }],\n      max_tokens: 300,\n      response_format: { type: 'json_object' }\n    }\n  }\n}];"},"id":"396e8a7f-2b89-4ee4-9298-d33d919618dc","name":"Preparar Llamada a OpenAI1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1680,752]},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/chat/completions","authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify($json.openaiPayload) }}","options":{"timeout":30000}},"id":"a07bd6aa-9da7-451a-94b5-e798e7388569","name":"Analizar con OpenAI Vision1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-1456,752],"retryOnFail":true,"credentials":{"openAiApi":{"id":"H6A1s3MW9pHuTWeX","name":"OpenAi account"}},"onError":"continueErrorOutput"},{"parameters":{"jsCode":"const aiResp = $input.first().json;\nconst prev   = $('Preparar Llamada a OpenAI1').first().json;\n\nconst phone          = prev.phone;\nconst conversationId = prev.conversationId;\nconst senderName     = prev.senderName;\nconst attachmentUrl  = prev.attachmentUrl;\n\nlet parsed = { es_comprobante: false };\ntry {\n  const content = aiResp?.choices?.[0]?.message?.content || '{}';\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  parsed = { es_comprobante: false, _error: e.message };\n}\n\nlet monto = 0;\nif (parsed.monto != null) {\n  const raw = String(parsed.monto).replace(/[^0-9,.]/g, '');\n  const norm = raw.includes('.') && !raw.includes(',') && raw.split('.')[1]?.length === 3\n    ? raw.replace('.', '') : raw.replace(',', '.');\n  monto = parseFloat(norm) || 0;\n}\n\nlet fecha = parsed.fecha || new Date().toISOString().split('T')[0];\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(fecha)) fecha = new Date().toISOString().split('T')[0];\n\nconst referencia = String(parsed.referencia || `WA-${Date.now()}`).substring(0, 50);\nconst metodo     = parsed.metodo || 'otro';\nconst confianza  = parseFloat(parsed.confianza) || 0;\n\nreturn [{\n  json: {\n    phone,\n    conversationId,\n    senderName,\n    attachmentUrl,\n    esComprobante: parsed.es_comprobante === true && monto > 0,\n    monto,\n    metodo,\n    referencia,\n    fecha,\n    confianza,\n    confianzaAlta: confianza >= 0.7\n  }\n}];"},"id":"b50d1d7b-f0a3-4cf0-ae69-44c0c780b209","name":"Procesar Respuesta IA1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1232,752]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cond-is-receipt","leftValue":"={{ $json.esComprobante }}","rightValue":true,"operator":{"type":"boolean","operation":"true"}},{"id":"cond-monto-gt0","leftValue":"={{ $json.monto }}","rightValue":0,"operator":{"type":"number","operation":"gt"}}],"combinator":"and"},"options":{}},"id":"ba0bb931-7f72-4b2e-bb8e-0aa14fe06dac","name":"┬┐Es comprobante v├ílido?1","type":"n8n-nodes-base.if","typeVersion":2,"position":[-1008,752]},{"parameters":{"url":"https://imvcrm-bknd.duckdns.org/api/n8n/client-debt","sendQuery":true,"queryParameters":{"parameters":[{"name":"phone","value":"={{ $json.phone }}"}]},"sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-api-key","value":"d927994f95870a3ad2a57fa70d0b767dfd27