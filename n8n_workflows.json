ywords.some(kw => messageContent.includes(kw));\nconst shouldProcess = isIncoming && !isPrivate && !!attachmentUrl;\n\nreturn [{\n  json: {\n    phone,\n    conversationId,\n    attachmentUrl,\n    messageContent: data?.content || '',\n    hasImageAttachment: !!attachmentUrl,\n    isIncoming,\n    isPrivate,\n    textSuggestsPayment,\n    shouldProcess,\n    senderName: data?.conversation?.meta?.sender?.name || 'Cliente',\n    inboxId: data?.conversation?.inbox_id || data?.inbox_id || null\n  }\n}];"},"id":"4c0047a4-8bc5-428e-a039-540f2f758325","name":"Extraer Datos del Mensaje1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-2128,752]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cond-should-process","leftValue":"={{ $('Webhook Chatwoot1').item.json.body.conversation.messages[0].attachments[0].file_type }}","rightValue":"image","operator":{"type":"string","operation":"equals"}},{"id":"c3e1c01a-aaea-4d71-9ebe-469247f1ee03","leftValue":"","rightValue":"","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"id":"baa1a515-e088-4ce1-aa47-688a08bab251","name":"┬┐Tiene imagen adjunta?1","type":"n8n-nodes-base.if","typeVersion":2,"position":[-1904,752]},{"parameters":{"httpMethod":"POST","path":"6edb6f06-a562-4654-85b7-764a64e0b296","options":{}},"id":"37ad54e0-94fc-4af3-9df0-b475e8c10e16","name":"Webhook Chatwoot1","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-2576,752],"webhookId":"6edb6f06-a562-4654-85b7-764a64e0b296"},{"parameters":{"conditions":{"options":{"caseSensitive":false,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"e88b52a4-ad29-48ac-a029-14287e4c0c51","leftValue":"={{ new Date().getDate() >= 20 || new Date().getDate() <= 10 }}","rightValue":"=","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{"ignore