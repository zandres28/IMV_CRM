ions":{}},"type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-480,96],"id":"8ad3ee6b-6ad5-4848-9383-b218d4d9b506","name":"If"},{"parameters":{"httpMethod":"POST","path":"chatwoot-ai-agent","responseMode":"responseNode","options":{}},"name":"Webhook Chatwoot1","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-704,96],"id":"da0c7491-be5f-4e9f-b2f9-0e2e652e863a","webhookId":"9cf017b7-cfc2-46e6-8b4a-282934d301d4","disabled":true},{"parameters":{"jsCode":"// Extraer datos del webhook de Chatwoot\n// Chatwoot puede enviar el body anidado en .body o directo\nconst raw = $input.first().json.body || $input.first().json;\nconst data = raw.data || raw;\n\n// message_type: 0 o 'incoming' = cliente | 1 o 'outgoing' = agente | 2 = actividad\nconst messageType = data?.message_type;\nconst isIncoming = messageType === 0 || messageType === 'incoming';\nconst isPrivate = data?.private === true;\nconst content = (data?.content || '').trim();\n\nconst conversationId = data?.conversation?.id || data?.conversation_id || null;\nconst accountId = data?.account?.id || 1;\nconst inboxId = data?.inbox_id || data?.conversation?.inbox_id;\n\n// Filtros: solo mensajes entrantes del cliente, no vac├¡os, no privados\nif (!isIncoming || isPrivate || !content) {\n  return [{ json: { skip: true, reason: `Ignorado: type=${messageType}, private=${isPrivate}, content=${content ? 'ok' : 'vac├¡o'}` } }];\n}\n\n// Ignorar mensajes que son solo emojis de confirmaci├│n o muy cortos sin info\nconst IGNORE_EXACT = ['­ƒæì','Ô£à','­ƒÖÅ','ok','si','no','dale','listo'];\nif (IGNORE_EXACT.includes(content.toLowerCase())) {\n  return [{ json: { skip: true, reason: 'Mensaje demasiado simple para el agente' } }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    conversationId,\n    accountId,\n    inboxId,\n    customerMessage: content,\n    customerName: data?.conversation?.meta?.sender?.name || 'Cliente',\n    customerPhone: data?.conversation?.meta?.sender?.phone_number || '',\n  }\n}];"},"name":"