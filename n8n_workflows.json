,"options":{}},"id":"3fcd18e7-2e78-4305-a99c-e3ee7461a7eb","name":"Webhook Evolution API","type":"n8n-nodes-base.webhook","typeVersion":1,"position":[-1536,208],"webhookId":"pagos-whatsapp"},{"parameters":{"conditions":{"string":[{"value1":"={{ $json.data.message.imageMessage }}","operation":"isNotEmpty"},{"value1":"={{ $json.data.message.caption }}","operation":"contains","value2":"pagado"}]},"combineOperation":"any"},"id":"50f9f382-2748-49de-b6bd-c170b06717eb","name":"┬┐Tiene imagen y dice PAGADO?","type":"n8n-nodes-base.if","typeVersion":1,"position":[-1328,208]},{"parameters":{"jsCode":"// Extraer informaci├│n del mensaje\nconst messageData = $input.first().json;\n\nconst telefono = messageData.data?.key?.remoteJid?.replace('@s.whatsapp.net', '') || '';\nconst messageId = messageData.data?.key?.id || '';\nconst caption = messageData.data?.message?.caption || '';\n\n// URL de la imagen - ajusta seg├║n tu Evolution API\nconst imageUrl = messageData.data?.message?.imageMessage?.url || '';\n\nreturn [{\n  json: {\n    telefono: telefono,\n    messageId: messageId,\n    caption: caption,\n    imageUrl: imageUrl,\n    timestamp: new Date().toISOString()\n  }\n}];"},"id":"66446385-772d-485d-8530-fa21da2016aa","name":"Extraer datos del mensaje","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1104,112]},{"parameters":{"url":"={{ $json.imageUrl }}","authentication":"predefinedCredentialType","nodeCredentialType":"evolutionApiApi","options":{"response":{"response":{"responseFormat":"file"}}}},"id":"e493a1f0-270b-4f57-bdf5-56a66671a3bd","name":"Descargar imagen","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[-880,112],"alwaysOutputData":true,"notesInFlow":true,"credentials":{"evolutionApiApi":{"id":"sB5XX3NrQcR6PqUZ","name":"Evolution account"}},"notes":"Ajusta la URL seg├║n tu configuraci├│n de Evolution API"},{"parameters":{"method":"POST","url":"https://api.ocr.space/parse/image","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"TU_API_KEY_DE_OCR_SPACE"}]},"sendBody":true,"contentType":"multipart-form-data","bodyParameters":{"parameters":[{"name":"file"},{"name":"language","value":"spa"},{"name":"isOverlayRequired","value":"false"},{"name":"detectOrientation","value":"true"},{"name":"scale","value":"true"}]},"options":{}},"id":"653010ee-b548-4649-8fd4-d7f69cae7812","name":"OCR - Extraer texto","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[-656,112],"notesInFlow":true,"credentials":{"httpHeaderAuth":{"id":"Epbpv8NiGf5vSbLa","name":"Header Auth account"}},"notes":"Opci├│n 1: OCR.space (gratis)\nRegistra en ocr.space para obtener API key"},{"parameters":{"jsCode":"// Obtener el texto extra├¡do por OCR\nconst ocrResult = $input.first().json;\nconst text = ocrResult.ParsedResults?.[0]?.ParsedText || '';\n\n// Obtener datos del flujo anterior\nconst telefono = $('Extraer datos del mensaje').first().json.telefono;\nconst messageId = $('Extraer datos del mensaje').first().json.messageId;\n\n// Patrones para extraer informaci├│n de comprobantes bancarios\nconst patterns = {\n  // Monto: busca n├║meros con puntos, comas o signos de peso\n  monto: /(?:total|monto|valor|importe|pagado)[:\\s]*\\$?\\s*([0-9]{1,3}(?:[.,][0-9]{3})*(?:[.,][0-9]{2})?)/i,\n  \n  // Referencia: n├║meros de comprobante o transacci├│n\n  referencia: /(?:ref(?:erencia)?|comprobante|n[┬░┬║]?|cus|transacci[o├│]n|aprobaci[o├│]n)[:\\s#]*([0-9A-Z-]{6,})/i,\n  \n  // Fecha en varios formatos\n  fecha: /(\\d{1,2}[\\/\\-]\\d{1,2}[\\/\\-]\\d{2,4})/,\n  \n  // Hora\n  hora: /(\\d{1,2}:\\d{2}(?::\\d{2})?(?:\\s*[AP]M)?)/i,\n  \n  // Bancos colombianos comunes\n  banco: /(bancolombia|banco\\s+de\\s+bogot[a├í]|davivienda|nequi|daviplata|bbva|scotiabank|colpatria|av\\s+villas|banco\\s+popular|banco\\s+occidente|banco\\s+caja\\s+social)/i,\n  \n  // C├®dula o documento\n  cedula: /(?:c[e├®]dula|cc|documento)[:\\s]*([0-9.]{7,})/i\n};\n\n// Extraer informaci├│n\nconst montoMatch = text.match(patterns.monto);\nconst montoRaw = montoMatch?.[1] || '';\nconst montoLimpio = montoRaw.replace(/[^0-9]/g, ''); // Solo n├║meros\n\nconst extracted = {\n  // Datos del mensaje\n  telefono: telefono,\n  messageId: messageId,\n  \n  // Datos extra├¡dos del OCR\n  textoCompleto: text,\n  monto: montoLimpio ? parseInt(montoLimpio) : null,\n  montoFormateado: montoRaw,\n  referencia: text.match(patterns.referencia)?.[1] || null,\n  fecha: text.match(patterns.fecha)?.[1] || null,\n  hora: text.match(patterns.hora)?.[1] || null,\n  banco: text.match(patterns.banco)?.[1] || null,\n  cedula: text.match(patterns.cedula)?.[1] || null,\n  \n  // Metadata\n  timestamp: new Date().toISOString(),\n  ocrExitoso: text.length > 50, // Validaci├│n b├ísica\n  \n  // Validaciones\n  datosCompletos: !!(montoLimpio && text.match(patterns.referencia)),\n  requiereRevision: text.length < 50 || !montoLimpio\n};\n\nreturn [{ json: extracted }];"},"id":"3adc254b-3cb0-4213-b729-2b59759ce0b1","name":"Analizar datos del pago","type":"n8n-nodes-base.code","typeVersion":2,"position":[-448,112]},{"parameters":{"conditions":{"string":[{"value1":"={{ $json.monto }}","operation":"isNotEmpty"},{"value1":"={{ $json.referencia }}","operation":"isNotEmpty"}]}},"id":"2e77c5f0-1065-428f-a54f-e4755ac0e80d","name":"┬┐Datos completos?","type":"n8n-nodes-base.if","typeVersion":1,"position":[-224,112]},{"parameters":{"method":"POST","url":"https://imvevoapi.duckdns.org/message/sendText/INSTANCE_NAME","authentication":"predefinedCredentialType","nodeCredentialType":"evolutionApiApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"{{ $('Analizar datos del pago').first().json.telefono }}\",\n  \"text\": \"Ô£à *Pago recibido y registrado*\\n\\n­ƒôï *Datos detectados:*\\n­ƒÆ░ Monto: ${{ $('Analizar datos del pago').first().json.montoFormateado }}\\n­ƒöó Referencia: {{ $('Analizar datos del pago').first().json.referencia }}\\n­ƒÅª Banco: {{ $(