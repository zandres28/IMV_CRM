ype: 'text', text: prompt },\n          { type: 'image_url', image_url: { url: attachmentUrl, detail: 'auto' } }\n        ]\n      }],\n      max_tokens: 300,\n      response_format: { type: 'json_object' }\n    }\n  }\n}];"},"id":"7a906d29-f277-435a-a033-3df095c6c5b4","name":"Preparar Llamada a OpenAI1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1680,752]},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/chat/completions","authentication":"predefinedCredentialType","nodeCredentialType":"openAiApi","sendHeaders":true,"headerParameters":{"parameters":[{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify($json.openaiPayload) }}","options":{"timeout":30000}},"id":"80885d2c-f1c6-4c90-93b2-36d6002202e9","name":"Analizar con OpenAI Vision1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-1456,752],"retryOnFail":true,"credentials":{"openAiApi":{"id":"H6A1s3MW9pHuTWeX","name":"OpenAi account"}},"onError":"continueErrorOutput"},{"parameters":{"jsCode":"const aiResp = $input.first().json;\nconst prev   = $('Preparar Llamada a OpenAI1').first().json;\n\nconst phone          = prev.phone;\nconst conversationId = prev.conversationId;\nconst senderName     = prev.senderName;\nconst attachmentUrl  = prev.attachmentUrl;\n\nlet parsed = { es_comprobante: false };\ntry {\n  const content = aiResp?.choices?.[0]?.message?.content || '{}';\n  const match = content.match(/\\{[\\s\\S]*\\}/);\n  if (match) parsed = JSON.parse(match[0]);\n} catch (e) {\n  parsed = { es_comprobante: false, _error: e.message };\n}\n\nlet monto = 0;\nif (parsed.monto != null) {\n  const raw = String(parsed.monto).replace(/[^0-9,.]/g, '');\n  const norm = raw.includes('.') && !raw.includes(',') && raw.split('.')[1]?.length === 3\n    ? raw.replace('.', '') : raw.replace(',', '.');\n  monto = parseFloat(norm) || 0;\n}\n\nlet fecha = parsed.fecha || new Date().toISOSt