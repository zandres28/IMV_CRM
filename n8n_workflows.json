message_type","value":"outgoing"}]},"options":{}},"id":"c0640872-77ce-4c41-9b4d-ac0b787e304e","name":"Confirm Success","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[656,48],"disabled":true},{"parameters":{"method":"POST","url":"={{ 'http://chatwoot_app:3000/api/v1/accounts/1/conversations/' + $node[\"Webhook Chatwoot\"].json.conversation.id + '/messages' }}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"api_access_token","value":"kVFWDgHMUHTwH8pMR1ixbyBZ"}]},"sendBody":true,"bodyParameters":{"parameters":[{"name":"content","value":"ÔÜá´©Å No se encontr├│ deuda pendiente para este cliente."},{"name":"private","value":true},{"name":"message_type","value":"outgoing"}]},"options":{}},"id":"d64458f6-3b3f-46a6-8708-8d8ebb9e527e","name":"Report No Debt","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[352,320],"disabled":true},{"parameters":{"jsCode":"const imageMessage = $json.body?.data?.message?.imageMessage;\n\nif (!imageMessage?.base64) {\n  throw new Error('El mensaje no contiene base64 de imagen');\n}\n\nreturn [{\n  binary: {\n    image: {\n      data: Buffer.from(imageMessage.base64, 'base64'),\n      mimeType: 'image/jpeg',\n      fileName: 'chatwoot_image.jpg'\n    }\n  }\n}];\n"},"id":"257c167b-de62-41fc-bc34-52df862d8cc4","name":"Convert to Base64","type":"n8n-nodes-base.code","typeVersion":2,"position":[-592,-384]},{"parameters":{"method":"POST","url":"https://api.openai.com/v1/chat/completions","authentication":"genericCredentialType","genericAuthType":"httpBearerAuth","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"model\": \"{{ $('Request Prompt Structure').item.json.model }}\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": [\n        {\n          \"type\": \"text\",\n          \"text\": {{ JSON.stringify($('Request Prompt Structure').item.json.prompt) }}\n        },\n        {\n          \"type\": \"image_url\",\n          \"image_url\": {\n            \"url\": \"{{ $('Convert to Base64').item.json.base64_image }}\"\n          }\n        }\n      ]\n    }\n  ],\n  \"response_format\": {{ $('Request Prompt Structure').item.json.format }}\n}","options":{}},"type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-336,48],"id":"1f86d64b-a065-45d8-b63a-322e99c88e26","name":"Analize Image Open AI","credentials":{"httpBearerAuth":{"id":"DsEuFi6r6fF3OEkQ","name":"Bearer Auth account"}}},{"parameters":{"assignments":{"assignments":[{"id":"b27a0d1d-f4d4-4e33-9c37-513139f89324","name":"prompt","value":"=# ­ƒº¥ Prompt Mejorado y Optimizado para OCR\n\nTu tarea es **extraer datos exclusivamente del contenido visible en la imagen**. No inventes, no interpretes y no completes informaci├│n faltante. Si un valor no est├í presente, deja el campo en blanco (`\"\"`).\n\n---\n\n## ­ƒôî 1. Captura los siguientes campos principales:\n\n* \"fecha\" (formato **dd-mm-yyyy**).\n* \"Banco destino\" o \"banco\" o \"destino\" \n* \"valor\" o \"monto\" o \"┬┐cu├ínto?\" o \"transferencia\" \n\n\n---\n\n## ­ƒôî 2. Reglas \n\n* Captura **todos los datos exactamente como aparecen**.\n* No modifiques texto, n├║meros ni formato.\n* Cada elemento debe contener solo:\n\n  * \"Fecha\"\n  * \"Banco Destino\"\n  * \"Valor\"\n\n* Si alg├║n valor est├í vac├¡o o no aparece en la imagen, devu├®lvelo como `\"\"`.\n\n---\n\n## ­ƒôî 3. Reglas estrictas de OCR\n\n* No normalices may├║sculas/min├║sculas.\n* No reestructures texto.\n* No corrijas palabras mal escritas.\n* Respeta s├¡mbolos de moneda, puntos, comas y espacios.\n* Lee ├║nicamente lo visible en la imagen.\n\n---\n\n## ­ƒôî 4. Respuesta\n\nDevuelve **├║nicamente** el JSON final, sin comentarios ni explicaciones.\n\n---\n\n## ­ƒôî Ejemplo de salida esperada\n\n```json\n{\n \n  \"fecha\": \"11-08-2024\",\n  \"banco_destino\": \"Nequi\"\n  \"valor\": \"65.000\",\n  \n}\n```\n","type":"string"},{"id":"99414d11-d332-4a4c-b350-33a016e32434","name":"body.data.message.base64","value":"={{ $json.body.data.message.base64 }}","type":"string"},{"id":"17cc1601-7046-4de3-b849-f9f6a659ffb5","name":"format","value":"={\n  \"type\": \"json_schema\",\n  \"json_schema\": {\n    \"name\": \"factura_ocr\",\n    \"schema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"fecha\": {\n          \"type\": \"string\",\n          \"description\": \"Fecha en formato dd-mm-yyyy\",\n          \"pattern\": \"^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-\\\\d{4}$\"\n        },\n        \"banco_destino\": { \"type\": \"string\" },\n        \"valor\": { \"type\": \"string\" }\n      },\n      \"required\": [        \n        \"fecha\",\n        \"banco_destino\",\n        \"valor\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"strict\": true\n  }\n}","type":"string"},{"id":"2531e779-2854-448a-ae11-6fc8e1217c02","name":"model","value":"gpt-4o-mini","type":"string"}]},"options":{}},"type":"n8n-nodes-base.set","typeVersion":3.4,"position":[-560,32],"id":"de834464-4ad9-49ca-8802-db1130db8cb2","name":"Request Prompt Structure","disabled":true},{"parameters":{"jsCode":"const response = $('Analize Image Open AI').first().json;\n\n// Extraer el contenido del mensaje\nlet parsed;\ntry {\n  // OpenAI devuelve la respuesta en choices[0].message.content\n  const content = response.choices[0].message.content;\n  parsed = JSON.parse(content);\n} catch (error) {\n  throw new Error(\"Error al parsear el JSON: \" + error.message);\n}\n\n// Devolver el objeto parseado\nreturn [{\n  json: parsed\n}];\n"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-144,48],"id":"ec976b46-87c8-4742-8df0-028bfac964de","name":"To JSON"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":2},"conditions":[{"id":"351d0d85-ab06-4404-8f61-0a4ad2c703b5","leftValue":"","rightValue":"","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"type":"n8n-nodes-base.if","typeVersion"