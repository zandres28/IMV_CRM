 datos del pago').first().json.referencia }}\\n­ƒÅª {{ $('Analizar datos del pago').first().json.banco }}\\n­ƒôà {{ $('Analizar datos del pago').first().json.fecha }}\\n\\nÔÜá´©Å Requiere verificaci├│n\"\n}","options":{}},"id":"f1bf2e33-497d-4706-b7c0-078be99b7660","name":"Notificar al admin","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[448,0],"notesInFlow":true,"credentials":{"evolutionApiApi":{"id":"sB5XX3NrQcR6PqUZ","name":"Evolution account"}},"notes":"Cambia NUMERO_ADMIN por tu n├║mero"},{"parameters":{"method":"POST","url":"https://imvevoapi.duckdns.org/message/sendText/ADMIN_NUMBER","authentication":"predefinedCredentialType","nodeCredentialType":"evolutionApiApi","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"number\": \"573006143054\",\n  \"text\": \"ÔÜá´©Å *Comprobante con datos incompletos*\\n\\n­ƒæñ Cliente: {{ $('Analizar datos del pago').first().json.telefono }}\\n\\nÔØî No se pudo extraer informaci├│n completa del OCR.\\n\\nRevisi├│n manual requerida.\"\n}","options":{}},"id":"f430c40a-d292-4db5-850b-027ef8ff2daa","name":"Notificar admin - Error OCR","type":"n8n-nodes-base.httpRequest","typeVersion":4.1,"position":[448,208],"credentials":{"evolutionApiApi":{"id":"sB5XX3NrQcR6PqUZ","name":"Evolution account"}}},{"parameters":{"content":"## Instrucciones de configuraci├│n:\n\n1. **Evolution API Webhook**: Configura en tu Evolution API para que env├¡e webhooks a este endpoint\n\n2. **OCR.space API Key**: Reg├¡strate en https://ocr.space/ocrapi y reemplaza TU_API_KEY_DE_OCR_SPACE\n\n3. **Base de datos**: Crea la tabla con este SQL:\n```sql\nCREATE TABLE pagos (\n    id SERIAL PRIMARY KEY,\n    telefono VARCHAR(20) NOT NULL,\n    monto DECIMAL(10,2),\n    referencia VARCHAR(100),\n    fecha_pago VARCHAR(20),\n    hora_pago VARCHAR(20),\n    banco VARCHAR(50),\n    cedula VARCHAR(20),\n    texto_ocr TEXT,\n    estado VARCHAR(30) DEFAULT 'pendiente_verificacion',\n    message_id VARCHAR(100),\n    fecha_registro TIMESTAMP DEFAU