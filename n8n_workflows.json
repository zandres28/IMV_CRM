pp:3000/api/v1/accounts/1/conversations/{{ $json.conversationId }}/messages","sendHeaders":true,"headerParameters":{"parameters":[{"name":"api_access_token","value":"kVFWDgHMUHTwH8pMR1ixbyBZ"},{"name":"Content-Type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{ JSON.stringify({ content: 'Hola, recibimos tu imagen. ­ƒôÄ\\n\\nPara registrar tu pago, env├¡a una foto clara del comprobante (Nequi, Bancolombia, Daviplata, transferencia, etc.) y lo procesaremos autom├íticamente.\\n\\nSi ya enviaste el soporte correcto y ves este mensaje, escr├¡benos y te ayudamos.', message_type: 'outgoing', private: false }) }}","options":{}},"id":"26f704eb-93bc-485d-93ae-1e7236f35472","name":"Responder: No Parece Comprobante1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[-784,752],"disabled":true},{"parameters":{"jsCode":"// Normalizar payload de Chatwoot\nconst raw = $input.first().json.body || $input.first().json;\nconst data = raw.data || raw;\n\n// ---- Tel├®fono del cliente ----\nlet phone = '';\nconst senderPhone = data?.conversation?.meta?.sender?.phone_number;\nconst sourceId    = data?.conversation?.contact_inbox?.source_id;\n\nif (senderPhone) {\n  phone = senderPhone.replace(/[^0-9]/g, '');\n} else if (sourceId) {\n  phone = sourceId.split('@')[0].replace(/[^0-9]/g, '');\n}\n\n// ---- Adjuntos ----\nconst attachments = data?.attachments || [];\nconst imageExts   = ['jpg', 'jpeg', 'png', 'webp', 'gif', 'pdf', 'bmp'];\n\nconst imageAttachment = attachments.find(a => {\n  const isImageType = ['image', 'file'].includes((a.file_type || '').toLowerCase());\n  const isImageExt  = imageExts.includes((a.extension || '').toLowerCase());\n  const urlHasImg   = imageExts.some(ext => (a.data_url || a.file_url || '').toLowerCase().includes('.' + ext));\n  return isImageType || isImageExt || urlHasImg;\n});\n\nconst attachmentUrl  = imageAttachment?.data_url || imageAttachment?.file_url || '';\nconst conversationId = data?.conversation?.id || data?.conversation_id || null;\nconst messageContent = (data?.content || '').toLowerCase();\nconst isIncoming     = (data?.message_type ?? -1) === 0;\nconst isPrivate      = data?.private === true;\n\nconst paymentKeywords = ['pago', 'soporte', 'comprobante', 'transferencia',\n  'nequi', 'bancolombia', 'daviplata', 'recibo', 'consignacion'];\nconst textSuggestsPayment = paymentKeywords.some(kw => messageContent.includes(kw));\nconst shouldProcess = isIncoming && !isPrivate && !!attachmentUrl;\n\nreturn [{\n  json: {\n    phone,\n    conversationId,\n    attachmentUrl,\n    messageContent: data?.content || '',\n    hasImageAttachment: !!attachmentUrl,\n    isIncoming,\n    isPrivate,\n    textSuggestsPayment,\n    shouldProcess,\n    senderName: data?.conversation?.meta?.sender?.name || 'Cliente',\n    inboxId: data?.conversation?.inbox_id || data?.inbox_id || null\n  }\n}];"},"id":"9b5f2278-89f3-40a3-a25f-2f156ec46b89","name":"Extraer Datos del Mensaje1","type":"n8n-nodes-base.code","typeVersion":2,"position":[-2128,752]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":1},"conditions":[{"id":"cond-should-process","leftValue":"={{ $('Webhook Chatwoot1').item.json.body.conversation.messages[0].attachments[0].file_type }}","rightValue":"image","operator":{"type":"string","operation":"equals"}},{"id":"c3e1c01a-aaea-4d71-9ebe-469247f1ee03","leftValue":"","rightValue":"","operator":{"type":"string","operation":"equals","name":"filter.operator.equals"}}],"combinator":"and"},"options":{}},"id":"35067765-352d-4567-b77b-1ef5c89e780f","name":"┬┐Tiene imagen adjunta?1","type":"n8n-nodes-base.if","typeVersion":2,"position":[-1904,752]},{"parameters":{"httpMethod":"POST","path":"chatwoot-soportes-pago","options":{}},"id":"498d2db0-6474-4223-8954-b499bee36c95","name":"Webhook Chatwoot1","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-2576,752],"webhookId":"chatwoot-