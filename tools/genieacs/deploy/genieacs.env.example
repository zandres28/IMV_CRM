# Copia este archivo como deploy/genieacs/genieacs.env y ajusta valores

# MongoDB (interno del stack GenieACS)
MONGO_INITDB_ROOT_USERNAME=genieacs
MONGO_INITDB_ROOT_PASSWORD=CAMBIAR_PASSWORD_MONGO
GENIEACS_MONGO_DB=genieacs

# Conexion Mongo usada por GenieACS
GENIEACS_MONGODB_CONNECTION_URL=mongodb://genieacs:CAMBIAR_PASSWORD_MONGO@mongo:27017/genieacs?authSource=admin

# Seguridad UI/API
GENIEACS_UI_JWT_SECRET=CAMBIAR_JWT_LARGO_Y_ALEATORIO

# Interfaces y puertos de servicios
GENIEACS_CWMP_INTERFACE=0.0.0.0
GENIEACS_CWMP_PORT=7547
GENIEACS_NBI_INTERFACE=0.0.0.0
GENIEACS_NBI_PORT=7557
GENIEACS_FS_INTERFACE=0.0.0.0
GENIEACS_FS_PORT=7567
GENIEACS_UI_INTERFACE=0.0.0.0
GENIEACS_UI_PORT=3000

# Logging a stdout/stderr para docker logs
GENIEACS_CWMP_ACCESS_LOG_FILE=/dev/stdout
GENIEACS_CWMP_ERROR_LOG_FILE=/dev/stderr
GENIEACS_NBI_ACCESS_LOG_FILE=/dev/stdout
GENIEACS_NBI_ERROR_LOG_FILE=/dev/stderr
GENIEACS_FS_ACCESS_LOG_FILE=/dev/stdout
GENIEACS_FS_ERROR_LOG_FILE=/dev/stderr
GENIEACS_UI_ACCESS_LOG_FILE=/dev/stdout
GENIEACS_UI_ERROR_LOG_FILE=/dev/stderr

# Directorio de extensiones/provisiones locales
GENIEACS_EXT_DIR=/opt/genieacs/ext
